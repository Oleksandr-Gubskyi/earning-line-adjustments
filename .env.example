APP_NAME="Earning Line Adjustments"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL runs as the "mysql" service in docker-compose.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=payroll
DB_USERNAME=payroll
DB_PASSWORD=secret

# This application has no HTTP surface, so nothing here needs a database table.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
