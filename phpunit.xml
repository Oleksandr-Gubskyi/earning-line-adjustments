<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
>
    <testsuites>
        <!-- Pure domain and application tests. These must not boot Laravel. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Event store and repository against a real MySQL database. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Artisan commands end to end. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!--
            Integration tests must run against MySQL, not SQLite.
            The stock Laravel skeleton sets sqlite/:memory: here, and the optimistic
            concurrency test would still pass under it, because SQLite also raises
            UniqueConstraintViolationException. It would prove nothing about MySQL.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="mysql"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="payroll_test"/>
        <env name="DB_USERNAME" value="payroll"/>
        <env name="DB_PASSWORD" value="secret"/>
    </php>
</phpunit>
